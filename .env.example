# POSTGRES_USER : choisi pour separer l'utilisateur applicatif de l'admin et limiter les privileges.
POSTGRES_USER=your_db_user

# POSTGRES_PASSWORD : choisi pour proteger l'acces a la base et eviter toute connexion sans authentification.
POSTGRES_PASSWORD=your_strong_password

# POSTGRES_DB : choisi pour imposer une base dediee au projet et isoler ses donnees.
POSTGRES_DB=vitalsync

# DATABASE_URL : choisie pour centraliser toute la configuration DB dans une seule variable standard.
DATABASE_URL=postgresql://your_db_user:your_strong_password@database:5432/vitalsync

# NODE_ENV : choisi pour activer le comportement production sans modifier le code applicatif.
NODE_ENV=production
